{
  "name": "green-shop-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.15 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --use-system-ca dist/main.js",
    "start:dev": "node --use-system-ca ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "5.9.2",
    "vitest": "5.0.4"
  }
}
