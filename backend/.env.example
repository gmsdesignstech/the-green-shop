DEV_OTP_CODE=123456
DEV_AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEV_CUSTOMER_TEST_PHONE_NUMBER=+919000000001
DEV_ADMIN_TEST_PHONE_NUMBER=+919000000002
DEV_DELIVERY_PARTNER_TEST_PHONE_NUMBER=+919000000003
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
