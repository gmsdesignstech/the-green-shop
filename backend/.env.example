PORT=3000
HOST=0.0.0.0
SUPABASE_URL=https://peyydzxmlgskeptkncmr.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
