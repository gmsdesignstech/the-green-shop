# MAPS_API_KEY: Required for Google Maps rendering, location markers, and routing.
# Configure your Google Maps Platform API key in the AI Studio Secrets panel.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_GOOGLE_MAPS_API_KEY
MAP_PROVIDER=google_maps

# Supabase Auth: use the project URL and publishable key from the Supabase Connect panel.
# Never put a service_role or secret key in this Android project.
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
API_BASE_URL=https://YOUR_API_HOST/api/v1/

# Optional debug-only Auth project. It MUST be separate from production.
# Configure its fixed test OTP in Supabase Auth; Android never validates the code itself.
DEV_SUPABASE_URL=
DEV_SUPABASE_PUBLISHABLE_KEY=
DEV_CUSTOMER_TEST_PHONE_NUMBER=
DEV_ADMIN_TEST_PHONE_NUMBER=
DEV_DELIVERY_PARTNER_TEST_PHONE_NUMBER=
# Any development test number/code must be configured provider-side in Supabase.
# The Android client always requests and verifies OTPs through Supabase Auth.

# Local customer UI testing only. Debug builds accept 123456 without creating a
# backend/Supabase session. Release builds always force this off.
DEV_FIXED_OTP_ENABLED=false

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
