# MAPS_API_KEY: Required for Google Maps rendering, location markers, and routing.
# Configure your Google Maps Platform API key in the AI Studio Secrets panel.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_GOOGLE_MAPS_API_KEY
MAP_PROVIDER=google_maps

# Supabase Auth: use the project URL and publishable key from the Supabase Connect panel.
# Never put a service_role or secret key in this Android project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Debug builds: use http://10.0.2.2:3000/api/v1/ for an Android emulator.
# For a physical phone, use http://<computer-LAN-IPv4>:3000/api/v1/.
API_BASE_URL=http://10.0.2.2:3000/api/v1/

# Debug builds can use the local backend's development OTP endpoint for customer,
# admin, and delivery-partner testing. The backend must also be in development mode
# with the same OTP and matching phone allowlist configured in backend/.env.
# Optional provider-backed development Auth project; must be separate from production.
DEV_SUPABASE_URL=
DEV_SUPABASE_PUBLISHABLE_KEY=
DEV_CUSTOMER_TEST_PHONE_NUMBER=
DEV_ADMIN_TEST_PHONE_NUMBER=
DEV_DELIVERY_PARTNER_TEST_PHONE_NUMBER=

# Local debug testing only: the app sends this fixed OTP to the backend dev-auth endpoint.
# Release builds always force this off.
DEV_FIXED_OTP_ENABLED=false

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
